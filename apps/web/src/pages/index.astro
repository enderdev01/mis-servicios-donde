      }
      .grip-bar { width: 2.4rem; height: 4px; border-radius: 99px; background: var(--line); }
      .grip:hover { color: var(--ink); }

      .answer {
        margin: 0; padding: 0 1.15rem .95rem; font-size: 1.02rem; font-weight: 800;
        letter-spacing: -.01em; text-wrap: balance;
      }

      .rail-body { overflow-y: auto; padding: .6rem 1.15rem calc(1.4rem + env(safe-area-inset-bottom)); }

      /*
       * The mobile tab strip: two halves of one track, so the split reads as a
