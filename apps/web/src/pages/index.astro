      #cell-info {
        max-width: 24rem; width: calc(100% - 3rem); margin: auto; padding: 1.4rem 1.5rem;
        border: 1px solid var(--line); border-radius: 16px;
        background: var(--surface); color: var(--ink);
        box-shadow: 0 24px 60px rgb(22 32 26 / .3);
      }
