      .onboarding[data-closing='true'] { opacity: 0; }
      /*
       * Mobile geometry contract: the card IS the viewport. It is a flex
       * column — illustration, then copy, then the navigation footer — and
       * nothing inside it scrolls. The copy takes the height it needs
       * (`flex: none`) and the illustration absorbs whatever is left
       * (`flex: 1 1 auto; min-height: 0`), so a short phone shrinks the
       * artwork instead of hiding prose behind a scrollbar. The top padding
       * reserves the row the absolutely positioned "Omitir" control sits in.
       */
      .onboarding-card {
        position: absolute; inset: 0;
        display: flex; flex-direction: column;
        padding:
          calc(.9rem + env(safe-area-inset-top) + 1.9rem)
          1.15rem
          calc(1.15rem + env(safe-area-inset-bottom));
        border: 0; background: transparent; box-shadow: none;
        overflow: hidden;
      }
      /* The content column: heading, prose, actions, progress, legal. It takes
       * its natural height and never scrolls — the stage yields instead. */
      .onboarding-content { flex: none; display: flex; flex-direction: column; min-width: 0; overflow: visible; }
      /*
       * The stage absorbs the leftover height, so the copy and the navigation
       * settle against the bottom edge within thumb reach instead of leaving a
       * hole under them. The FIGURE, not the stage, is what carries the fixed
       * size: it keeps `34dvh` on every step — step 2 has the activation
       * control and step 4 the longest body, and sizing the box by "whatever
       * the copy left over" rendered each step differently — and it is
       * centred in whatever band the stage ends up with.
       */
      .onboarding-stage {
        flex: 1 1 auto; min-height: 0;
        display: flex; align-items: center; justify-content: center;
      }
      /*
       * Step changes fade: the illustration and the content column dim out
       * together, the copy swaps, and both come back. The duration lives in
       * --onboarding-fade so script timings and CSS stay in lockstep.
       */
      .onboarding-stage, .onboarding-content { transition: opacity var(--onboarding-fade, 160ms) ease; }
      .onboarding-card[data-fade='out'] .onboarding-stage,
      .onboarding-card[data-fade='out'] .onboarding-content { opacity: 0; }
      /*
       * The head carries "Omitir". In the DOM it follows the step heading so
       * a forward Tab from the open-time focus reaches skip first; `order: -1`
       * keeps it visually on top of the card. `order` moves paint, never
       * focus order.
       */
      .onboarding-head {
        order: -1; display: flex; justify-content: flex-end; min-height: 1.1rem;
        /* Lifted out of the flow on mobile: the illustration needs to paint
         * above it while the control stays right after the heading in DOM
         * order, which `order` alone could not deliver from inside the
         * content column. The desktop block puts it back in the flow. */
