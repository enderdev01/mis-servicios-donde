---
import { siteNotice, unofficialNotice } from '../content.js';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#EFF2EC" />
    <meta name="description" content="Mapa comunitario de cortes de agua, luz e internet en Lima. Información generada por vecinos, no oficial." />
    <title>Mis Servicios | Mapa comunitario de cortes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@600;700&family=Nunito:wght@400;600;800&display=swap" />
  </head>
  <body>
    <!--
      THESIS: A gravity-rain garden, not a status dashboard. Each service falls its
      own way because that is physically true: water drains, current climbs, data
      orbits and never lands. Refuses the dark ops-console grid this category ships.
      OWN-WORLD: Dusk green-gray ground; cyan, amber and violet rains as the only
      accents; dashed directional trajectories with arrowheads; rounded sans; the
      legend plate is the one element always held level.
      STORY: A neighbour in the dark asks "is it only my house?", reads the nearest
      confirmed cut in seconds, and adds their own report.
      FIRST VIEWPORT: Map full-bleed as the garden. Floating unofficial plate top.
      Rail left on desktop, draggable sheet on mobile: question, level legend,
      nearest cuts by distance, report action within thumb reach.
      FORM: gravity-rain garden, candidate 6 of the dealt hand, seed key 092b6402.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, DESIGN.md, and every shipping raster carrying its
      provenance.
    -->
    <div class="garden">
      <div id="outage-map" aria-label="Mapa de zonas con cortes confirmados. Los mismos cortes aparecen como texto en el panel."></div>
    </div>

    <!--
      Identity: a permanent marker, not a standing plate. The two-line notice
      used to sit over the map on every viewport and buy its space out of the
      Leaflet control strip; here it collapses behind one compact control that
      still carries the non-official framing ("No oficial") at all times, and
      expands the wordmark and the full naming on demand. The wrapper is what
      `watchNoticeClearance` measures, so the controls follow whichever state
      is showing.
    -->
    <div class="identity" id="identity">
      <button
        type="button"
        class="identity-toggle"
        id="identity-toggle"
        aria-expanded="false"
        aria-controls="site-identity"
        aria-label="Aviso: información no oficial"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 11.2v4.8" />
          <path d="M12 7.9h.01" />
        </svg>
        <span>No oficial</span>
      </button>
      <header class="plate" id="site-identity" hidden>
        <p class="wordmark">Mis Servicios</p>
        <p class="unofficial" role="note">{siteNotice} {unofficialNotice}</p>
      </header>
    </div>

    <!--
      First-run onboarding: a section that comes BEFORE the map on every
      viewport, owning the whole screen from the moment the page opens and
      blocking pointer interaction with the map and rail behind it, with the
      permanent non-official naming integrated on every step. Mobile stacks one
      column (illustration, copy, navigation) and nothing inside it scrolls —
      the illustration yields height instead; desktop (>=56rem) composes the
      same parts into a two-column editorial spread. No dialog semantics are
      taken; focus moves to the card on open and returns where it came from on
      close, and Escape closes it from anywhere. A successful location
      activation never completes the flow: it shows a success state on the
      location step, and only finishing step 4 persists completion.
    -->
    <div class="onboarding" id="onboarding" hidden role="region" aria-label="Introducción al mapa comunitario" tabindex="-1"></div>

    <aside class="rail" id="rail" data-state="peek">
      <button type="button" class="grip" id="grip" aria-expanded="false" aria-controls="rail-body">
        <span class="grip-bar" aria-hidden="true"></span>
        <span class="grip-label" id="grip-label">Ver el panel</span>
      </button>
      <p class="answer" id="answer">Buscando cortes confirmados…</p>

      <div class="rail-body" id="rail-body">
        <h1>¿Es solo tu casa?</h1>
        <p class="lede">Tres vecinos distintos tienen que reportar lo mismo para que un corte quede confirmado. Hasta entonces aparece como "sin confirmar".</p>

        <!--
          Mobile only: the sheet used to stack both panels into one scroll —
          filters, the outage list and the whole report form — so the form sat
          entirely below the fold. Below 56rem these two controls show one panel
          at a time; from 56rem the rail is a 25rem column with room for both,
          so `watchRailTabs` strips the tab semantics and CSS shows both again.
          The control is inert markup until that watcher wires it, which keeps
          the no-JS render complete rather than half a tab strip.
        -->
        <div class="rail-tabs" id="rail-tabs" hidden>
          <button type="button" class="rail-tab" id="rail-tab-report" data-panel="report-panel">Reportar</button>
          <button type="button" class="rail-tab" id="rail-tab-reports" data-panel="reports-panel">Reportes</button>
        </div>

        <!--
          The legend lives with the outage list: it decodes the same
          confirmation levels the list and the map blobs use, and pairing them
          keeps the report tab down to the form alone.
        -->
        <section class="panel" id="reports-panel" aria-labelledby="near-heading">
          <h2 id="near-heading">Cortes cerca tuyo</h2>
          <ul id="map-legend" class="legend"></ul>
          <div class="filters">
            <label class="filter">
              <span>Ver distrito</span>
              <select id="district-filter" name="district">
                <option value="all">Todos</option>
              </select>
            </label>
            <label class="filter">
              <span>Ver servicio</span>
              <select id="service-filter" name="service">
                <option value="all">Todos</option>
                <option value="water">Agua</option>
                <option value="electricity">Luz</option>
                <option value="internet">Internet</option>
              </select>
            </label>
            <label class="filter">
              <span>Ver empresa</span>
              <select id="provider-filter" name="provider">
                <option value="all">Todas</option>
              </select>
            </label>
          </div>
          <div id="map-state" role="status" aria-live="polite">No hay cortes confirmados en este momento.</div>
          <ul id="cell-list" aria-label="Cortes confirmados por zona"></ul>
          <button type="button" class="locate" id="locate" hidden>Activar mi ubicación</button>
        </section>

        <section class="panel" id="report-panel" aria-labelledby="report-heading">
          <h2 id="report-heading">Reportar un corte</h2>
          <p class="fine">Al enviar el reporte, tu ubicación exacta se manda una sola vez: el servidor la convierte en una zona amplia y la descarta. No se guarda ni se muestra.</p>
          <form id="report-form" novalidate>
            <fieldset>
              <legend>¿Qué servicio?</legend>
              <div class="choices">
                <label><input type="checkbox" name="services" value="water" /> <span>Agua</span></label>
                <label><input type="checkbox" name="services" value="electricity" /> <span>Luz</span></label>
                <label><input type="checkbox" name="services" value="internet" /> <span>Internet</span></label>
              </div>
            </fieldset>
            <div id="provider-fields" class="provider-fields" hidden></div>
            <fieldset>
              <legend>¿Qué está pasando?</legend>
              <div class="choices">
                <label><input type="radio" name="status" value="outage" checked /> <span>No hay servicio</span></label>
                <label><input type="radio" name="status" value="restored" /> <span>Ya volvió</span></label>
              </div>
            </fieldset>
            <button type="submit" id="submit">Enviar reporte</button>
            <p id="report-state" role="alert" aria-live="assertive"></p>
          </form>
        </section>
      </div>
    </aside>

    <dialog id="thanks" aria-labelledby="thanks-title">
      <h2 id="thanks-title">¡Gracias por tu reporte!</h2>
      <p>Tu reporte ya está ayudando a tu comunidad. Aparecerá en el mapa como "sin confirmar" hasta que otros vecinos reporten lo mismo.</p>
      <button type="button" id="thanks-close">Entendido</button>
    </dialog>

    <dialog id="cell-info" aria-labelledby="cell-info-title">
      <h2 id="cell-info-title">Cortes en esta zona</h2>
      <ul id="cell-info-list" class="cell-info-list"></ul>
      <div id="cell-info-streets" class="cell-info-streets" role="status" aria-live="polite" hidden></div>
      <button type="button" id="cell-info-close">Cerrar</button>
    </dialog>

    <script>
      import L from 'leaflet';
      import 'leaflet/dist/leaflet.css';
      import {
        basemap, boundaryContains, boundsOf, cellCenter, cellContainsPosition, cellInZone, defaultCenter, defaultZoom, describeCell, formatDistance,
        leadAnswer, loadingMessage, providerLabel, providerOptions, serviceStyles, sortByProximity, summarizeCells, toCellBlobs, toPublicCells, zoneBounds,
        type NearbyCell, type Provider, type PublicCell, type Service, type ZoneSummary,
      } from '../map.js';
      import { ONBOARDING_STORAGE_KEY, persistOnboardingStatus, shouldShowOnboarding } from '../onboarding.js';
      import { onboardingSteps, locationSuccess, siteNotice, unofficialNotice } from '../content.js';

      const $ = <T extends Element>(selector: string): T | null => document.querySelector<T>(selector);
      const districtFilter = $<HTMLSelectElement>('#district-filter');
      const filter = $<HTMLSelectElement>('#service-filter');
      const providerFilter = $<HTMLSelectElement>('#provider-filter');
      const mapState = $<HTMLElement>('#map-state');
      const cellList = $<HTMLUListElement>('#cell-list');
      const legend = $<HTMLUListElement>('#map-legend');
      const reportForm = $<HTMLFormElement>('#report-form');
      const reportState = $<HTMLElement>('#report-state');
      const locate = $<HTMLButtonElement>('#locate');
      const rail = $<HTMLElement>('#rail');
      const railBody = $<HTMLElement>('#rail-body');
      const railTabs = $<HTMLElement>('#rail-tabs');
      const grip = $<HTMLButtonElement>('#grip');
      const gripLabel = $<HTMLElement>('#grip-label');
      const answer = $<HTMLElement>('#answer');
      const thanks = $<HTMLDialogElement>('#thanks');
      const thanksClose = $<HTMLButtonElement>('#thanks-close');
      const cellInfo = $<HTMLDialogElement>('#cell-info');
      const cellInfoList = $<HTMLUListElement>('#cell-info-list');
      const cellInfoStreets = $<HTMLElement>('#cell-info-streets');
      const cellInfoClose = $<HTMLButtonElement>('#cell-info-close');
      const providerFields = $<HTMLDivElement>('#provider-fields');
      const deviceId = (() => {
        const key = 'mis-servicios:device-id';
        const existing = localStorage.getItem(key);
        if (existing) return existing;
        const fresh = crypto.randomUUID();
        localStorage.setItem(key, fresh);
        return fresh;
      })();

      let map: L.Map | undefined;
      let cellLayer: L.LayerGroup | undefined;
      let origin: [number, number] | undefined;
      let meMarker: L.Marker | undefined;
      let zones: ZoneSummary[] = [];
      let myDistrictSlug: string | undefined;
      let painted: NearbyCell[] = [];
      let fetchedCells: PublicCell[] = [];

      const icons: Record<Service, string> = {
        water: '<path d="M12 3.5c3.4 4 5.2 6.6 5.2 8.9a5.2 5.2 0 0 1-10.4 0c0-2.3 1.8-4.9 5.2-8.9Z"/>',
        electricity: '<path d="M13.4 3 6.8 13.1h4.2L10.2 21l6.9-10.4h-4.3L13.4 3Z"/>',
        internet: '<circle cx="12" cy="12" r="3.1"/><ellipse cx="12" cy="12" rx="9" ry="4.4" transform="rotate(-24 12 12)"/>',
      };

      function icon(service: Service): string {
        return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[service]}</svg>`;
      }

      /** Always offered, not only after a denial: "where am I" is the second question. */
      function addLocateControl(instance: L.Map): void {
        const Locate = L.Control.extend({
          onAdd(): HTMLElement {
            const button = L.DomUtil.create('button', 'locate-control');
            button.type = 'button';
            button.title = 'Centrar en mi ubicación';
            button.setAttribute('aria-label', 'Centrar en mi ubicación');
            button.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3.4"/><path d="M12 2.6v3M12 18.4v3M2.6 12h3M18.4 12h3"/></svg>';
            L.DomEvent.on(button, 'click', (event) => { L.DomEvent.stop(event); centreOnMe(); });
            return button;
          },
        });
        new Locate({ position: 'topright' }).addTo(instance);
      }

      /** Marks the visitor with a div, never a vector: the overlay pane counts hexagons. */
      function markMe(): void {
        if (!map || !origin) return;
        const icon = L.divIcon({ className: 'me', html: '<span></span>', iconSize: [18, 18] });
        if (meMarker) meMarker.setLatLng(origin);
        else meMarker = L.marker(origin, { icon, keyboard: false, interactive: false, zIndexOffset: -100 }).addTo(map);
      }

      function centreOnMe(): void {
        if (origin && map) {
          if (myDistrictSlug && districtFilter) districtFilter.value = myDistrictSlug;
          // Re-centering is a personal action: fitting the whole district makes
          // the visitor's own position look remote again.
          map.flyTo(origin, Math.max(map.getZoom(), 16), { animate: true, duration: .45 });
          return;
        }
        askPosition();
      }

      /** A tile or WebGL failure must never take the textual panel down with it. */
      function startMap(): void {
        const host = $<HTMLElement>('#outage-map');
        if (!host) return;
        try {
          map = L.map(host, { scrollWheelZoom: true, zoomControl: false, attributionControl: true })
            .setView(defaultCenter, defaultZoom);
          L.control.zoom({ position: 'topright' }).addTo(map);
          addLocateControl(map);
          L.tileLayer(basemap.url, { attribution: basemap.attribution, maxZoom: basemap.maxZoom }).addTo(map);
          cellLayer = L.layerGroup().addTo(map);
        } catch { map = undefined; cellLayer = undefined; }
      }

      function renderLegend(): void {
        if (!legend) return;
        legend.replaceChildren();
        for (const [name, style] of Object.entries(serviceStyles) as [Service, typeof serviceStyles.water][]) {
          const item = document.createElement('li');
          item.style.setProperty('--ink', style.fill);
          item.innerHTML = `${icon(name)}<b>${style.label}</b>`;
          legend.append(item);
        }
      }

      function renderProviderFields(): void {
        if (!providerFields || !reportForm) return;
        const previous = new Map(Array.from(providerFields.querySelectorAll<HTMLSelectElement>('select[data-service-provider]')).map((select) => [select.dataset.serviceProvider, select.value]));
        const services = Array.from(reportForm.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')).map((input) => input.value as Service);
        providerFields.replaceChildren();
        providerFields.hidden = services.length === 0;
        for (const service of services) {
          const label = document.createElement('label');
          label.className = 'provider-field';
          const text = document.createElement('span');
          text.textContent = `Empresa de ${serviceStyles[service].label.toLowerCase()}`;
          const select = document.createElement('select');
          select.required = true;
          select.dataset.serviceProvider = service;
          select.setAttribute('aria-label', text.textContent);
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.textContent = 'Selecciona una empresa';
          select.append(placeholder);
          for (const option of providerOptions[service]) {
            const item = document.createElement('option');
            item.value = option.id;
            item.textContent = option.label;
            select.append(item);
          }
          const retained = previous.get(service);
          if (retained && providerOptions[service].some((option) => option.id === retained)) select.value = retained;
          label.append(text, select);
          providerFields.append(label);
        }
      }

      function populateProviderFilter(): void {
        if (!providerFilter) return;
        const selectedService = filter?.value ?? 'all';
        const options = selectedService === 'all'
          ? Object.values(providerOptions).flat()
          : providerOptions[selectedService as Service];
        const unique = new Map(options.map((option) => [option.id, option]));
        const previous = providerFilter.value;
        providerFilter.replaceChildren(new Option('Todas', 'all'));
        for (const option of unique.values()) providerFilter.append(new Option(option.label, option.id));
        providerFilter.value = unique.has(previous as Provider) ? previous : 'all';
      }

      function renderCells(cells: NearbyCell[]): void {
        painted = cells;
        if (!map || !cellLayer) return;
        cellLayer.clearLayers();
        for (const blob of toCellBlobs(cells)) {
          const style = serviceStyles[blob.service];
          // The API gives us the H3 cell, not the private report coordinate.
          // For the visitor's own cell, local positioning removes the visual
          // gap without transmitting or storing the precise location.
          const centre = origin && blob.h3Cells.length === 1 && cellContainsPosition(blob.h3Cells[0], origin) ? origin : blob.centre;
          const circle = L.circle(centre, {
            radius: blob.radiusMetres,
            color: style.stroke,
            weight: blob.confirmed ? 2.5 : 2,
            dashArray: blob.confirmed ? undefined : '5 5',
            fillColor: style.fill,
            fillOpacity: blob.confirmed ? .2 : .12,
            className: 'cell',
          });
          circle.on('click', () => openCellInfo(blob.h3Cells, blob.service));
          circle.addTo(cellLayer);
        }
        markMe();
      }

      function openCellInfo(h3Cells: string[], service?: Service): void {
        const group = painted.filter((cell) => h3Cells.includes(cell.h3Cell));
        const geometry = service ? group.filter((cell) => cell.service === service) : group;
        const [blob] = toCellBlobs(geometry);
        if (group.length === 0 || !blob) return;
        showCellInfo(group, blob.centre, blob.radiusMetres);
      }

      function showCellInfo(group: NearbyCell[], centre: [number, number], radiusMetres: number): void {
        if (!cellInfo || !cellInfoList || !cellInfoStreets) return;
        cellInfoList.replaceChildren();
        for (const cell of group) {
          const style = serviceStyles[cell.service];
          const item = document.createElement('li');
          item.style.setProperty('--ink', style.fill);
          const neighbours = `${cell.reports} vecino${cell.reports === 1 ? '' : 's'}`;
          const state = cell.confirmed ? 'confirmado' : 'sin confirmar';
          item.innerHTML = `${icon(cell.service)}<span>${style.label}<small>${providerLabel(cell.provider)}</small></span><em>${neighbours} · ${state}</em>`;
          cellInfoList.append(item);
        }
        cellInfoStreets.hidden = false;
        cellInfoStreets.dataset.state = 'loading';
        cellInfoStreets.textContent = 'Analizando las posibles calles…';
        void nearbyStreetNames(centre, radiusMetres).then((streets) => {
          cellInfoStreets.removeAttribute('data-state');
          cellInfoStreets.replaceChildren();
          if (streets.length === 0) {
            cellInfoStreets.textContent = 'No pudimos identificar calles cercanas.';
            return;
          }
          const title = document.createElement('strong');
          title.textContent = 'Posibles calles afectadas';
          const list = document.createElement('ul');
          for (const street of streets) {
            const item = document.createElement('li');
            item.textContent = street;
            list.append(item);
          }
          cellInfoStreets.append(title, list);
          cellInfoStreets.hidden = false;
        });
        cellInfo.showModal();
      }

      async function nearbyStreetNames(centre: [number, number], radiusMetres: number): Promise<string[]> {
        const [latitude, longitude] = centre;
        const query = `[out:json][timeout:8];way(around:${Math.round(radiusMetres)},${latitude},${longitude})["highway"]["name"];out tags;`;
        try {
          const response = await fetch('https://overpass-api.de/api/interpreter', {
            method: 'POST',
            headers: { 'content-type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: new URLSearchParams({ data: query }),
            signal: AbortSignal.timeout(7_000),
          });
          if (!response.ok) throw new Error('street_lookup_failed');
          const data = await response.json() as { elements?: { tags?: { name?: unknown } }[] };
          const names = new Map<string, string>();
          for (const element of data.elements ?? []) {
            const name = typeof element.tags?.name === 'string' ? element.tags.name.trim() : '';
            if (name && !names.has(name.toLocaleLowerCase())) names.set(name.toLocaleLowerCase(), name);
          }
          return [...names.values()].sort((a, b) => a.localeCompare(b, 'es')).slice(0, 8);
        } catch {
          return reverseGeocode(centre);
        }
      }

      async function reverseGeocode(centre: [number, number]): Promise<string[]> {
        try {
          const [latitude, longitude] = centre;
          const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${latitude}&lon=${longitude}&zoom=16`, { signal: AbortSignal.timeout(5_000) });
          if (!response.ok) return [];
          const data = await response.json() as { address?: { road?: string; pedestrian?: string } };
          const road = data.address?.road ?? data.address?.pedestrian;
          return road ? [road] : [];
        } catch { return []; }
      }

      function renderList(cells: NearbyCell[]): void {
        if (answer) answer.textContent = leadAnswer(cells);
        if (!cellList || !mapState) return;
        cellList.replaceChildren();
        const confirmedCount = cells.filter((cell) => cell.confirmed).length;
        const pendingCount = cells.length - confirmedCount;
        mapState.textContent = summarizeCells(confirmedCount, pendingCount);
        for (const cell of cells) {
          const style = serviceStyles[cell.service];
          const item = document.createElement('li');
          item.style.setProperty('--ink', style.fill);
          if (!cell.confirmed) item.classList.add('pending');
          item.dataset.h3Cell = cell.h3Cell;
          item.tabIndex = 0;
          const distance = cell.metres === undefined ? '' : `<em>${formatDistance(cell.metres)}</em>`;
          item.innerHTML = `${icon(cell.service)}<span>${describeCell(cell.service, cell.confirmed)} · ${providerLabel(cell.provider)}</span>${distance}`;
          const open = () => {
            const c = cellCenter(cell.h3Cell);
            if (c && map) map.setView(c, Math.max(map.getZoom(), 15), { animate: true });
            openCellInfo([cell.h3Cell]);
          };
          item.addEventListener('click', open);
          item.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } });
          cellList.append(item);
        }
      }

      async function loadCells(silent = false): Promise<void> {
        if (!filter || !mapState) return;
        const suffix = filter.value === 'all' ? '' : `?service=${encodeURIComponent(filter.value)}`;
        if (!silent) mapState.textContent = loadingMessage;
        let cells: PublicCell[] = [];
        try {
          const response = await fetch(`/v1/cells${suffix}`);
          cells = response.ok ? toPublicCells(await response.json()) : [];
        } catch { cells = []; }
        fetchedCells = cells;
        render(!silent);
      }

      function currentDistrict(): string {
        return districtFilter?.value ?? 'all';
      }

      function filterByDistrict(cells: NearbyCell[]): NearbyCell[] {
        const slug = currentDistrict();
        if (slug === 'all') return cells;
        const zone = zones.find((entry) => entry.slug === slug);
        if (!zone) return cells;
        return cells.filter((cell) => cellInZone(cell.h3Cell, zone.boundary));
      }

      function filterByProvider(cells: NearbyCell[]): NearbyCell[] {
        const selected = providerFilter?.value ?? 'all';
        return selected === 'all' ? cells : cells.filter((cell) => cell.provider === selected);
      }

      function applyDistrict(): void {
        if (!map) return;
        const slug = currentDistrict();
        const zone = zones.find((entry) => entry.slug === slug);
        if (zone) {
          const box = L.latLngBounds(zoneBounds(zone.boundary));
          if (origin && slug === myDistrictSlug) box.extend(origin);
          map.fitBounds(box, { padding: [48, 48], maxZoom: 15 });
          return;
        }
        const bounds = boundsOf(toCellBlobs(painted));
        if (bounds) {
          const box = L.latLngBounds(bounds);
          if (origin) box.extend(origin);
          map.fitBounds(box, { padding: [48, 48], maxZoom: 15 });
        } else if (origin) map.setView(origin, 15);
      }

      function render(center = true): void {
        const ordered = sortByProximity(fetchedCells, origin);
        const filtered = filterByProvider(filterByDistrict(ordered));
        renderList(filtered);
        renderCells(filtered);
        if (center) applyDistrict();
      }

      async function loadZones(): Promise<void> {
        try {
          const response = await fetch('/v1/zones');
          if (response.ok) zones = (await response.json()) as ZoneSummary[];
        } catch { zones = []; }
        populateDistrictFilter();
        const here = origin;
        if (here) {
          myDistrictSlug = zones.find((zone) => boundaryContains(zone.boundary, here[0], here[1]))?.slug;
          if (myDistrictSlug && districtFilter && districtFilter.value === 'all') districtFilter.value = myDistrictSlug;
          render(false);
          centreOnMe();
        }
      }

      function populateDistrictFilter(): void {
        if (!districtFilter) return;
        const current = districtFilter.value;
        districtFilter.replaceChildren();
        const all = document.createElement('option');
        all.value = 'all';
        all.textContent = 'Todos';
        districtFilter.append(all);
        for (const zone of zones) {
          const option = document.createElement('option');
          option.value = zone.slug;
          option.textContent = zone.name;
          districtFilter.append(option);
        }
        districtFilter.value = zones.some((entry) => entry.slug === current) ? current : 'all';
      }

      /**
       * Denial is a first-class state, never an error: the map stays on the pilot
       * zone and the panel offers the permission again on the visitor's terms.
       * The request itself is never automatic: it fires only from an explicit
       * visitor action (onboarding activation, locate controls, report submit).
       */
      function askPosition(onSuccess?: () => void, onError?: () => void): void {
        if (!navigator.geolocation) { locate?.removeAttribute('hidden'); onError?.(); return; }
        locate?.setAttribute('data-busy', 'true');
        navigator.geolocation.getCurrentPosition(
          (position) => {
            origin = [position.coords.latitude, position.coords.longitude];
            myDistrictSlug = zones.find((zone) => boundaryContains(zone.boundary, position.coords.latitude, position.coords.longitude))?.slug;
            if (myDistrictSlug && districtFilter) districtFilter.value = myDistrictSlug;
            locate?.setAttribute('hidden', '');
            locate?.removeAttribute('data-busy');
            onSuccess?.();
            void loadCells(true).then(centreOnMe);
          },
          () => { locate?.removeAttribute('data-busy'); locate?.removeAttribute('hidden'); onError?.(); },
          { maximumAge: 60_000, timeout: 8_000 },
        );
      }

      function setRail(state: 'peek' | 'open'): void {
        rail?.setAttribute('data-state', state);
        grip?.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
        if (gripLabel) gripLabel.textContent = state === 'open' ? 'Ocultar el panel' : 'Ver el panel';
      }

      /*
       * The mobile rail used to stack both panels into one scroll: the framing,
       * the legend, three filters, the outage list and the whole report form —
       * 743px of content in a 489px sheet on a 390px-wide phone, with the form
       * entirely below the fold. Below 56rem the two panels become two tabs
       * ("Reportar" first, "Reportes" second) so one set of options shows at a
       * time. From 56rem the rail is a 25rem column that fits both, so the
       * layout there is untouched.
       *
       * The semantics are applied and removed with the layout, never left
       * standing: a tablist whose tabs are `display: none` would still announce
       * a two-tab widget on desktop, where there is nothing to switch. So the
       * whole contract — the roles, `aria-selected`, `aria-controls`, the
       * roving tabindex and the panels' own tabpanel roles — is added when the
       * narrow layout applies and stripped when it stops applying.
       */
      const railTabButtons = railTabs
        ? Array.from(railTabs.querySelectorAll<HTMLButtonElement>('.rail-tab'))
        : [];
      const railTabPanels = railTabButtons.map((tab) => $<HTMLElement>(`#${tab.dataset.panel}`));
      /*
       * Each panel's own heading, captured before any tab semantics touch it.
       * Leaving the split has to put back exactly what was there rather than
       * re-derive it from the panel's position — the tabs are ordered
       * "Reportar" first while the panels keep their reading order, so the two
       * lists do not line up and deriving it silently crosses the labels.
       */
      const railPanelLabels = railTabPanels.map((panel) => panel?.getAttribute('aria-labelledby') ?? null);

      function setRailTab(selected: number): void {
        railTabButtons.forEach((tab, index) => {
          const isSelected = index === selected;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          // Roving tabindex: one Tab press leaves the strip for the panel it
          // opened, and the arrow keys are what move between the tabs.
          tab.tabIndex = isSelected ? 0 : -1;
          const panel = railTabPanels[index];
          if (panel) panel.dataset.tabState = isSelected ? 'active' : 'inactive';
        });
      }

      function applyRailTabs(on: boolean): void {
        if (!railTabs || !railBody || railTabButtons.length === 0) return;
        railTabs.hidden = !on;
        if (on) {
          railBody.dataset.tabs = 'on';
          railTabs.setAttribute('role', 'tablist');
          railTabs.setAttribute('aria-label', 'Secciones del panel');
          railTabButtons.forEach((tab, index) => {
            tab.setAttribute('role', 'tab');
            const panel = railTabPanels[index];
            if (!panel) return;
            tab.setAttribute('aria-controls', panel.id);
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', tab.id);
            // A panel that scrolls has to be focusable, or a keyboard visitor
            // reaching it from the tab cannot scroll it.
            panel.tabIndex = 0;
          });
          // Whichever tab was already selected survives a rotation back to
          // narrow; a first application starts on "Reportar".
          setRailTab(Math.max(railTabButtons.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'), 0));
          return;
        }
        // Wide again: hand both panels back, with no tab semantics left over.
        delete railBody.dataset.tabs;
        railTabs.removeAttribute('role');
        railTabs.removeAttribute('aria-label');
        railTabButtons.forEach((tab, index) => {
          tab.removeAttribute('role');
          tab.removeAttribute('aria-controls');
          tab.tabIndex = -1;
          const panel = railTabPanels[index];
          if (!panel) return;
          panel.removeAttribute('role');
          // `aria-labelledby` pointed at the tab; the section's own heading
          // labels it again, exactly as it did before the split existed.
          const label = railPanelLabels[index];
          if (label) panel.setAttribute('aria-labelledby', label);
          else panel.removeAttribute('aria-labelledby');
          panel.removeAttribute('tabindex');
          delete panel.dataset.tabState;
        });
      }

      function watchRailTabs(): void {
        if (!railTabs || !railBody || railTabButtons.length === 0) return;
        railTabButtons.forEach((tab, index) => {
          tab.addEventListener('click', () => setRailTab(index));
          tab.addEventListener('keydown', (event) => {
            const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
            if (step === 0) return;
            event.preventDefault();
            const next = (index + step + railTabButtons.length) % railTabButtons.length;
            setRailTab(next);
            railTabButtons[next]?.focus();
          });
        });
        // The same 56rem boundary the stylesheet uses. Keeping it in one
        // `matchMedia` means a rotation or a resized window moves the ARIA and
        // the layout together instead of leaving one of them behind.
        const narrow = matchMedia('(max-width: 55.99rem)');
        applyRailTabs(narrow.matches);
        narrow.addEventListener('change', (event) => applyRailTabs(event.matches));
      }

      /*
       * The identity is fixed above the garden, so the map controls it overlaps
       * would be unreachable. The top-right Leaflet controls only need to drop
       * below it when it can actually reach them horizontally — collapsed it is
       * a narrow badge that never does, expanded on a small screen it always
       * does, and on a wide desktop the panel still ends far left of the strip.
       * Measuring the wrapper (badge + panel) makes the clearance follow the
       * expand/collapse as well as text wrapping and viewport changes, through
       * one ResizeObserver.
       */
      function updateNoticeClearance(): void {
        if (!identity) return;
        const identityRect = identity.getBoundingClientRect();
        const controlStrip = 66; // 34px locate control + 10px inset + breathing room
        if (identityRect.right + controlStrip >= window.innerWidth) {
          const clearance = identityRect.height + 20; // .75rem offset + .5rem gap
          document.documentElement.style.setProperty('--notice-clearance', `${Math.ceil(clearance)}px`);
        } else {
          document.documentElement.style.removeProperty('--notice-clearance');
        }
      }

      function watchNoticeClearance(): void {
        if (!identity) return;
        updateNoticeClearance();
        // The observer covers text wrapping and viewport changes; expanding and
        // collapsing recompute synchronously in `setIdentityExpanded`, so the
        // controls never spend a frame underneath the panel.
        if (typeof ResizeObserver === 'function') new ResizeObserver(updateNoticeClearance).observe(identity);
        else window.addEventListener('resize', updateNoticeClearance);
      }

      /*
       * The identity panel is collapsed by default on every viewport: the
       * standing marker is the control itself, and the wordmark plus the full
       * unofficial naming are one activation away. The control, Escape and a
       * pointer outside all collapse it; Escape hands focus back to the control
       * so the panel is never a dead end. Escape here runs before the
       * onboarding's own handler and stops it when the panel is the thing that
       * is open, so the innermost open surface always owns the key.
       */
      function setIdentityExpanded(expanded: boolean): void {
        if (!plate || !identityToggle) return;
        plate.hidden = !expanded;
        identityToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        updateNoticeClearance();
      }

      function watchIdentityPanel(): void {
        if (!identity || !plate || !identityToggle) return;
        identityToggle.addEventListener('click', () => {
          setIdentityExpanded(identityToggle.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || plate.hidden) return;
          event.stopImmediatePropagation();
          setIdentityExpanded(false);
          identityToggle.focus({ preventScroll: true });
        });
        document.addEventListener('pointerdown', (event) => {
          if (plate.hidden) return;
          if (event.target instanceof Node && identity.contains(event.target)) return;
          setIdentityExpanded(false);
        });
      }

      /*
       * First-run onboarding: four illustrated steps ahead of the live map,
       * rendered from one copy source (content.js). The layer is a region, not
       * a dialog: it owns the viewport on every size, but nothing behind it is
       * competing for the visitor, so no focus is trapped and only the
       * open-time focus move and close-time restore are managed.
       */
      const onboarding = $<HTMLElement>('#onboarding');
      const plate = $<HTMLElement>('#site-identity');
      const identity = $<HTMLElement>('#identity');
      const identityToggle = $<HTMLButtonElement>('#identity-toggle');
      let onboardingIndex = 0;
      let onboardingFocusReturn: HTMLElement | null = null;
      let onboardingBuilt = false;
      /**
       * Slide fades: a move dims the current step out, swaps the copy, and
       * brings the new step back. Moves are queued so rapid clicks still land
       * one step each, and the fade duration mirrors `--onboarding-fade`.
       */
      const ONBOARDING_FADE_MS = 160;
      /**
       * Queued *destinations*, not deltas. The drain has to take a move off the
       * queue before it can await the fade, so a queue of deltas stops
       * describing where the flow is heading the moment a move is in flight —
       * the delta is gone and `onboardingIndex` has not caught up yet.
       */
      const onboardingMoveQueue: number[] = [];
      /**
       * The step the visitor has already asked for, updated synchronously by
       * `moveOnboarding` and only reached by `onboardingIndex` once the fades
       * and the illustration decode have finished. Every decision about what a
       * control should do next reads this; only rendering reads the settled
       * index. Deciding on the settled one is what let a fast tap on the last
       * step queue a move the drain then discarded, leaving the card over the
       * map.
       */
      let onboardingPendingIndex = 0;
      let onboardingMoving = false;
      let onboardingClosing = false;
      /**
       * Set once a location request succeeds while the onboarding is open.
       * Success is a state on the location step, never a completion: the flow
       * stays open, "Siguiente" keeps advancing, and only finishing step 4
       * persists anything.
       */
      let onboardingLocationShown = false;
      const onboardingParts = {
        stage: document.createElement('div') as HTMLElement,
        content: document.createElement('div') as HTMLElement,
        figure: document.createElement('figure') as HTMLElement,
        image: document.createElement('img') as HTMLImageElement,
        title: document.createElement('h2') as HTMLElement,
        body: document.createElement('p') as HTMLElement,
        note: document.createElement('p') as HTMLElement,
        success: document.createElement('p') as HTMLElement,
        activate: document.createElement('button') as HTMLButtonElement,
        prev: document.createElement('button') as HTMLButtonElement,
        next: document.createElement('button') as HTMLButtonElement,
        skip: document.createElement('button') as HTMLButtonElement,
        progress: document.createElement('p') as HTMLElement,
        dots: document.createElement('div') as HTMLElement,
        legal: document.createElement('p') as HTMLElement,
      };

      function buildOnboarding(): void {
        if (!onboarding || onboardingBuilt) return;
        onboardingBuilt = true;
        const card = document.createElement('div');
        card.className = 'onboarding-card';
        // The stage (illustration) and the content column let CSS compose a
        // two-column editorial layout on desktop while the mobile card keeps
        // stacking both vertically inside one floating card.
        const stage = onboardingParts.stage;
        stage.className = 'onboarding-stage';
        const figure = onboardingParts.figure;
        figure.className = 'onboarding-figure';
        const image = onboardingParts.image;
        image.decoding = 'async';
        figure.append(image);
        stage.append(figure);
        const skip = onboardingParts.skip;
        skip.type = 'button';
        skip.className = 'onboarding-skip';
        skip.textContent = 'Omitir';
        const title = onboardingParts.title;
        title.className = 'onboarding-title';
        title.tabIndex = -1;
        const head = document.createElement('div');
        head.className = 'onboarding-head';
        head.append(skip);
        const body = onboardingParts.body;
        body.className = 'onboarding-body';
        const note = onboardingParts.note;
        note.className = 'onboarding-note';
        // A real polite live region: the element is always rendered and only
        // its text changes, so screen readers announce the denial insertion.
        // The empty state is styled away (no box) instead of display:none.
        note.setAttribute('role', 'status');
        note.setAttribute('aria-live', 'polite');
        const success = onboardingParts.success;
        success.className = 'onboarding-success';
        success.tabIndex = -1;
        // A real polite live region (never toggled hidden): the text change
        // announces while the element is already in the accessibility tree.
        success.setAttribute('role', 'status');
        success.setAttribute('aria-live', 'polite');
        const activate = onboardingParts.activate;
        activate.type = 'button';
        activate.className = 'onboarding-activate';
        activate.textContent = 'Activar ubicación';
        const legal = onboardingParts.legal;
        legal.className = 'onboarding-legal';
        legal.textContent = `${siteNotice} ${unofficialNotice}`;
        const meta = document.createElement('div');
        meta.className = 'onboarding-meta';
        const dots = onboardingParts.dots;
        dots.className = 'onboarding-dots';
        dots.setAttribute('aria-hidden', 'true');
        const progress = onboardingParts.progress;
        progress.className = 'onboarding-progress';
        meta.append(dots, progress);
        const nav = document.createElement('div');
        nav.className = 'onboarding-nav';
        const prev = onboardingParts.prev;
        prev.type = 'button';
        prev.className = 'onboarding-ghost';
        prev.textContent = 'Anterior';
        const next = onboardingParts.next;
        next.type = 'button';
        next.className = 'onboarding-primary';
        nav.append(prev, next);
        // DOM order is focus order: the heading first, then the skip control
        // right after it, so one forward Tab from the open-time focus (the step
        // heading) reaches "Omitir". CSS `order` puts the head back on top
        // visually without changing that forward order. The nav lives OUTSIDE
        // the scrollable content column (a real footer, never a sticky overlay
        // painted over copy): unfocusable elements (meta, legal) sit between
        // it and the content in DOM order, so the forward Tab order is
        // unchanged — title, skip, activate, then the two nav buttons.
        const content = onboardingParts.content;
        content.className = 'onboarding-content';
        content.append(title, head, body, note, success, activate, meta, legal);
        card.append(stage, content, nav);
        onboarding.append(card);

        skip.addEventListener('click', () => closeOnboarding('skipped'));
        prev.addEventListener('click', () => moveOnboarding(-1));
        next.addEventListener('click', () => {
          // Against the *pending* step, never the settled one: during a fade the
          // settled index still names the step being left, and deciding on it
          // sends the finishing tap into the move queue, where the drain drops
          // it — the card stays over the map on the last step.
          if (onboardingPendingIndex === onboardingSteps.length - 1) { closeOnboarding('completed'); return; }
          moveOnboarding(1);
        });
        activate.addEventListener('click', () => {
          if (activate.hasAttribute('data-busy')) return;
          activate.setAttribute('data-busy', 'true');
          askPosition(
            () => {
              activate.removeAttribute('data-busy');
              // Success stays on the step: announce it, keep the flow open.
              onboardingLocationShown = true;
              onboardingParts.activate.hidden = true;
              onboardingParts.note.textContent = '';
              onboardingParts.success.textContent = `${locationSuccess.message}. ${locationSuccess.detail}`;
              onboardingParts.success.focus({ preventScroll: true });
            },
            () => {
              activate.removeAttribute('data-busy');
              note.textContent = 'No pudimos obtener tu ubicación ahora. Puedes activarla después con el control del mapa o continuar sin ella.';
            },
          );
        });
      }

      /*
       * Escape closes the onboarding from anywhere: focus may sit on the map or
       * the rail while the card is open, so the listener is global but only
       * alive while the onboarding is open.
       */
      const onboardingEscape = (event: KeyboardEvent): void => {
        if (event.key === 'Escape') { event.preventDefault(); closeOnboarding('skipped'); }
      };

      const prefersReducedMotion = (): boolean =>
        typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;
      const waitForFade = (): Promise<void> =>
        new Promise((resolve) => window.setTimeout(resolve, ONBOARDING_FADE_MS));
      /**
       * Decoded-image cache shared by the eager preload and every step swap.
       * Awaiting the same URL twice is free, and it lets a move hold the
       * transparent slide until the next illustration is ready — without it the
       * reused <img> keeps painting the previous bitmap while the new file is
       * still in flight, which reads as the old image lingering after the fade.
       */
      const onboardingImageLoads = new Map<string, Promise<void>>();
      function loadOnboardingImage(src: string): Promise<void> {
        const cached = onboardingImageLoads.get(src);
        if (cached) return cached;
        const pending = new Promise<void>((resolve) => {
          const probe = new Image();
          probe.decoding = 'async';
          probe.addEventListener('load', () => resolve(), { once: true });
          probe.addEventListener('error', () => resolve(), { once: true });
          probe.src = src;
        });
        onboardingImageLoads.set(src, pending);
        return pending;
      }
      /** Warms the cache for every step at open, so swaps have nothing to wait for. */
      function preloadOnboardingImages(): void {
        for (const step of onboardingSteps) void loadOnboardingImage(step.image);
      }

      function moveOnboarding(delta: number): void {
        const target = Math.min(Math.max(onboardingPendingIndex + delta, 0), onboardingSteps.length - 1);
        // Already heading for that edge: queueing this move would only give the
        // drain something to discard.
        if (target === onboardingPendingIndex) return;
        onboardingPendingIndex = target;
        onboardingMoveQueue.push(target);
        void drainOnboardingMoves();
      }

      /**
       * Drains queued step moves, fading the current slide out before the copy
       * swaps and back in after it. The queue keeps rapid clicks lossless —
       * three quick taps still land three steps ahead — while reduced motion
       * swaps directly and settles synchronously.
       */
      async function drainOnboardingMoves(): Promise<void> {
        if (onboardingMoving || onboardingClosing) return;
        onboardingMoving = true;
        const card = onboardingParts.stage.parentElement;
        const animated = card !== null && !prefersReducedMotion();
        while (onboardingMoveQueue.length > 0 && !onboardingClosing) {
          const target = onboardingMoveQueue.shift() as number;
          if (target === onboardingIndex) continue;
          if (animated && card) {
            card.dataset.fade = 'out';
            await waitForFade();
            if (onboardingClosing) break;
          }
          onboardingIndex = target;
          renderOnboardingStep();
          // Hold the transparent slide until the new illustration is decoded,
          // so the fade-in can never reveal the previous step's bitmap.
          const step = onboardingSteps[target];
          if (animated && step) {
            await loadOnboardingImage(step.image);
            if (onboardingClosing) break;
          }
          if (animated && card) {
            card.removeAttribute('data-fade');
            await waitForFade();
          }
        }
        onboardingMoving = false;
      }

      function renderOnboardingStep(): void {
        const step = onboardingSteps[onboardingIndex];
        if (!step) return;
        onboardingParts.image.src = step.image;
        onboardingParts.image.alt = step.alt;
        onboardingParts.title.textContent = step.title;
        onboardingParts.body.textContent = step.body;
        onboardingParts.note.textContent = '';
        // A completed activation is remembered for the visit: returning to the
        // location step shows the success state again, without re-requesting.
        const locationReady = step.id === 'location' && onboardingLocationShown;
        onboardingParts.activate.hidden = step.id !== 'location' || onboardingLocationShown;
        onboardingParts.success.textContent = locationReady ? `${locationSuccess.message}. ${locationSuccess.detail}` : '';
        onboardingParts.prev.disabled = onboardingIndex === 0;
        onboardingParts.next.textContent = onboardingIndex === onboardingSteps.length - 1 ? 'Empezar a usar el mapa' : 'Siguiente';
        onboardingParts.progress.textContent = `Paso ${onboardingIndex + 1} de ${onboardingSteps.length}`;
        onboardingParts.dots.replaceChildren(...onboardingSteps.map((_, index) => {
          const dot = document.createElement('span');
          if (index === onboardingIndex) dot.setAttribute('data-active', 'true');
          return dot;
        }));
        onboardingParts.title.focus({ preventScroll: true });
      }

      function closeOnboarding(status: 'completed' | 'skipped'): void {
        if (!onboarding || onboarding.hidden || onboardingClosing) return;
        // Storage can be full or blocked (private mode); skipping must still work.
        try { persistOnboardingStatus(localStorage, status); } catch { /* this visit simply replays next time */ }
        const finish = (): void => {
          onboarding.hidden = true;
          onboarding.removeAttribute('data-closing');
          document.removeEventListener('keydown', onboardingEscape);
          onboarding.replaceChildren();
          onboardingBuilt = false;
          onboardingIndex = 0;
          onboardingPendingIndex = 0;
          onboardingMoveQueue.length = 0;
          onboardingClosing = false;
          onboardingLocationShown = false;
          onboardingFocusReturn?.focus({ preventScroll: true });
          onboardingFocusReturn = null;
        };
        // Entering the app is a fade too: the last step (or a skip) dissolves
        // the whole surface before the layer is torn down. Reduced motion
        // closes at once, with nothing to wait for.
        if (prefersReducedMotion()) { finish(); return; }
        onboardingClosing = true;
        onboarding.dataset.closing = 'true';
        window.setTimeout(finish, ONBOARDING_FADE_MS);
      }

      function startOnboarding(): void {
        if (!onboarding) return;
        let stored: string | null = null;
        try { stored = localStorage.getItem(ONBOARDING_STORAGE_KEY); } catch { stored = null; }
        if (!shouldShowOnboarding(stored)) return;
        buildOnboarding();
        preloadOnboardingImages();
        onboardingFocusReturn = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        onboarding.hidden = false;
        onboarding.focus({ preventScroll: true });
        renderOnboardingStep();
        document.addEventListener('keydown', onboardingEscape);
      }

      startMap();
      renderLegend();
      populateProviderFilter();
      renderProviderFields();
      watchNoticeClearance();
      watchIdentityPanel();
      watchRailTabs();

      /*
       * Input modality gates the presentational focus ring: the onboarding's
       * programmatic focus moves (step heading, activation-success status)
       * must never paint a ring on a fresh load or after pointer interaction
       * — a painted outline there reads as auto-selected text — while real
       * keyboard input must bring the indicator back. The document element
       * carries the last input modality; CSS scopes the heading/status rules
       * to keyboard use, and real controls keep the normal :focus-visible
       * behavior unconditionally.
       */
      const inputModalityRoot = document.documentElement;
      document.addEventListener('keydown', () => { inputModalityRoot.dataset.input = 'keyboard'; }, true);
      document.addEventListener('pointerdown', () => { inputModalityRoot.dataset.input = 'pointer'; }, true);

      grip?.addEventListener('click', () => setRail(rail?.getAttribute('data-state') === 'open' ? 'peek' : 'open'));
      locate?.addEventListener('click', () => askPosition());
      filter?.addEventListener('change', () => { populateProviderFilter(); void loadCells(); });
      providerFilter?.addEventListener('change', () => render());
      districtFilter?.addEventListener('change', () => render());
      reportForm?.querySelectorAll<HTMLInputElement>('input[name="services"]').forEach((input) => input.addEventListener('change', renderProviderFields));
      void loadZones();
      void loadCells();
      startOnboarding();

      reportForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!reportForm || !reportState) return;
        const services = Array.from(reportForm.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')).map((input) => input.value as Service);
        if (services.length === 0) { reportState.dataset.tone = 'warn'; reportState.textContent = 'Elige al menos un servicio afectado.'; return; }
        const providers = Object.fromEntries(services.map((service) => [service, reportForm.querySelector<HTMLSelectElement>(`select[data-service-provider="${service}"]`)?.value ?? '']));
        if (Object.values(providers).some((provider) => !provider)) { reportState.dataset.tone = 'warn'; reportState.textContent = 'Selecciona la empresa de cada servicio.'; return; }
        if (!navigator.geolocation) { reportState.dataset.tone = 'error'; reportState.textContent = 'No podemos obtener tu ubicación. Prueba desde un navegador que permita el acceso.'; return; }
        reportState.dataset.tone = 'info';
        reportState.textContent = 'Solicitando tu ubicación…';
        navigator.geolocation.getCurrentPosition(async (position) => {
          const status = reportForm.querySelector<HTMLInputElement>('input[name="status"]:checked')?.value;
          const response = await fetch('/v1/reports', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ submissionId: crypto.randomUUID(), deviceId, services, providers, status, latitude: position.coords.latitude, longitude: position.coords.longitude }),
          });
          if (response.ok) {
            reportState.dataset.tone = 'success';
            reportState.textContent = '';
            reportForm.reset();
            renderProviderFields();
            thanks?.showModal();
            void loadCells(true);
          } else if (response.status === 409) {
            reportState.dataset.tone = 'warn';
            reportState.textContent = 'Ya reportaste este corte hace poco. Un reporte por dispositivo alcanza.';
          } else {
            reportState.dataset.tone = 'error';
            reportState.textContent = 'No pudimos enviar tu reporte ahora. Vuelve a intentarlo más tarde.';
          }
        }, () => { reportState.dataset.tone = 'error'; reportState.textContent = 'Necesitamos tu ubicación para agrupar el reporte en una zona amplia.'; });
      });
      thanksClose?.addEventListener('click', () => thanks?.close());
      cellInfoClose?.addEventListener('click', () => cellInfo?.close());
    </script>

    <style is:global>
