      /*
       * First-run onboarding: a section that comes *before* the map on every
       * viewport, never a card parked inside it. The layer takes pointer
       * events and paints the opaque daylight ground, so the map and rail
       * behind it are unreachable until the visitor finishes or skips. Mobile
       * stacks one column; the >=56rem block composes the same parts into two.
       */
      .onboarding {
        position: fixed; inset: 0; z-index: 800; pointer-events: auto;
        --onboarding-fade: 160ms;
        background:
          radial-gradient(72rem 46rem at 14% 24%, rgb(44 157 218 / .09), transparent 62%),
          linear-gradient(168deg, var(--surface) 0%, var(--ground) 56%, #E5EBE3 100%);
