      /* The thank-you modal: a native dialog styled into the daylight world. */
      #thanks {
        max-width: 22rem; width: calc(100% - 3rem); margin: auto; padding: 1.4rem 1.5rem;
        border: 1px solid var(--line); border-radius: 16px;
        background: var(--surface); color: var(--ink);
