      }
      #cell-info button:hover { background: #0B120E; }
      .cell-info-list { margin: 0 0 1rem; padding: 0; list-style: none; display: grid; gap: .4rem; }
      .cell-info-list li {
        display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .55rem;
        padding: .6rem .7rem; border: 1px solid var(--line); border-radius: 11px; background: #fff; font-size: .88rem;
      }
      .cell-info-list svg { width: 17px; height: 17px; color: var(--ink); }
      .cell-info-list li > span { font-weight: 800; }
      .cell-info-list li > span small { display: block; margin-top: .12rem; color: var(--muted); font-size: .72rem; font-weight: 600; }
      .cell-info-list em { color: var(--muted); font-style: normal; font-size: .78rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .cell-info-streets { margin: 0 0 1rem; color: var(--muted); font-size: .85rem; line-height: 1.5; }
      .cell-info-streets strong { color: var(--ink); font-weight: 800; }
      .cell-info-streets ul { margin: .35rem 0 0; padding-left: 1.1rem; }
      .cell-info-streets li + li { margin-top: .15rem; }
      .cell-info-streets[data-state='loading'] { color: var(--agua); font-weight: 700; }

      /* Mobile: a sheet that rises from the ground. Desktop: a rail beside it. */
      .rail {
        position: fixed; z-index: 600; left: 0; right: 0; bottom: 0;
        max-height: 86dvh; display: flex; flex-direction: column;
        border-top: 1px solid var(--line); border-radius: 20px 20px 0 0;
        background: rgb(251 252 249 / .97); backdrop-filter: blur(14px);
        box-shadow: 0 -10px 34px rgb(22 32 26 / .16);
        transition: transform .42s cubic-bezier(.16, 1, .3, 1);
      }
      .rail[data-state='peek'] { transform: translateY(calc(100% - 9.6rem)); }
      .rail[data-state='open'] { transform: translateY(0); }

      .grip {
        display: grid; justify-items: center; gap: .4rem; width: 100%;
        padding: .7rem 1rem .3rem; border: 0; background: none; color: var(--muted);
