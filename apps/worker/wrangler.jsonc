{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mis-servicios-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Production D1 database, created with `wrangler d1 create mis-servicios` (region ENAM).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mis-servicios",
      "database_id": "3cab0b64-c967-4ccc-9817-f78b45bfd955",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SCHEDULER", "class_name": "Scheduler" },
      { "name": "REPORT_LIMITER", "class_name": "ReportLimiter" },
      // One instance per H3 cell: serializes the read-decide-write of report intake, which D1 cannot do with a lock.
      { "name": "CELL_COORDINATOR", "class_name": "CellCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Scheduler", "ReportLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["CellCoordinator"] }
  ],
  // Global per-IP limit (was RATE_LIMIT_MAX per RATE_LIMIT_WINDOW_MS in memory).
  "ratelimits": [
    { "name": "GLOBAL_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } }
  ],
  // Only re-arms the scheduler alarm if it is missing; it never queries the database.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Enable in order: map, dispatch (needs the Telegram secrets), intake, then retention once data collection starts.
    // The map is on: it only publishes aggregated cells. Intake stays off until alerts can be delivered, because
    // dispatch being off cancels every alert an episode creates and that cannot be recovered.
    "INTAKE_ENABLED": "false",
    "PUBLIC_MAP_ENABLED": "true",
    "ALERT_DISPATCH_ENABLED": "false",
    "RETENTION_WORKER_ENABLED": "false",
    "H3_RESOLUTION": "9",
    // Hourly is enough: public reads already hide expired episodes, so this job only materialises the closure
    // and an idle database is not queried more often than needed.
    "EPISODE_EXPIRY_INTERVAL_SECONDS": "3600"
  }
  // Secrets (set with `wrangler secret put`, never committed): DEVICE_TOKEN_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID.
}
